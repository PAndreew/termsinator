{
  "name": "termsinator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BYOK browser extension that finds, analyses and explains the terms & conditions of any site in plain language.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "cross-env TARGET=chrome vite build",
    "build:firefox": "cross-env TARGET=firefox vite build"
  },
  "dependencies": {
    "preact": "^10.22.0",
    "webextension-polyfill": "^0.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.14.2",
    "@types/webextension-polyfill": "^0.12.1",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitest/coverage-v8": "^1.6.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vite-plugin-web-extension": "^4.1.6",
    "vitest": "^1.6.0"
  }
}
