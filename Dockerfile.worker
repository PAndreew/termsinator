FROM golang:1.23-alpine AS go-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/worker ./cmd/worker

FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/processor
RUN groupadd --system worker && useradd --system --gid worker --home /app worker
WORKDIR /app
COPY processor/requirements.txt /app/processor/requirements.txt
RUN pip install --no-cache-dir -r /app/processor/requirements.txt
COPY --from=go-build /out/worker /worker
COPY processor/process /app/process
COPY processor/termsinator_processor /app/processor/termsinator_processor
COPY docs/EVALUATION_MATRIX.md /app/docs/EVALUATION_MATRIX.md
COPY schemas /app/schemas
RUN chmod 0555 /worker /app/process && chown -R worker:worker /app
USER worker:worker
ENTRYPOINT ["/worker"]
