FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/api ./cmd/api

FROM alpine:3.21
RUN apk add --no-cache ca-certificates && addgroup -S api && adduser -S -G api api
COPY --from=build /out/api /api
EXPOSE 8080
USER api:api
ENTRYPOINT ["/api"]
