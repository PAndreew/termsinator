---
interface Props { title: string; description?: string }
const { title, description = 'Analysis of website terms and privacy policies.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title === 'Termsinator' ? title : `${title} · Termsinator`}</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="preview-banner" role="status"><strong>Community preview.</strong> Submitted sites join a review queue. Analyses are currently run manually and published as capacity allows.</div>
    <header>
      <a class="brand" href="/"><img src="/termsinator.svg?v=head-logo" width="38" height="38" alt="" /> <span>Termsinator</span></a>
      <nav aria-label="Main navigation">
        <a href="/analyses/">Analysed policies</a>
        <a href="/methodology/">Methodology</a>
        <a href="/api-key/">API &amp; tools</a>
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href="https://github.com/PAndreew/termsinator" target="_blank" rel="noreferrer">GitHub</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>Termsinator provides automated analysis, not legal advice.</footer>
  </body>
</html>
