---
import Base from '../layouts/Base.astro';
---
<Base title="Analysed policies">
  <h1>Analysed policies</h1>

  <form id="filters">
    <select id="offering" aria-label="Offering type"><option value="">All offering types</option></select>
    <select id="sector" aria-label="Sector"><option value="">All sectors</option></select>
    <select id="sort" aria-label="Sort order">
      <option value="score">Highest score</option>
      <option value="date">Newest analysis</option>
      <option value="name">Name</option>
    </select>
  </form>

  <p class="muted">Open a snapshot to read its complete criterion-by-criterion analysis and citations.</p>
  <div id="analyses" aria-live="polite">Loading…</div>

  <script is:inline type="module">
    import { renderAnalyses } from '/analysis-snapshots.js';

    const target = document.querySelector('#analyses');
    const offering = document.querySelector('#offering');
    const sector = document.querySelector('#sector');
    const sort = document.querySelector('#sort');

    fetch('/api/v1/categories').then(response => response.json()).then(data => {
      if (offering) {
        for (const item of data.offering_types || []) offering.add(new Option(item.label, item.id));
      }
      if (sector) {
        for (const item of data.sectors || []) sector.add(new Option(item.label, item.id));
      }
    }).catch(() => {});

    for (const control of [offering, sector, sort]) control?.addEventListener('change', load);
    load();

    async function load() {
      if (!target) return;
      target.textContent = 'Loading…';
      const params = new URLSearchParams();
      if (offering?.value) params.set('offering_type', offering.value);
      if (sector?.value) params.set('sector', sector.value);
      const endpoint = params.size ? `/api/v1/rankings?${params}` : '/api/v1/analyses';
      try {
        const response = await fetch(endpoint);
        if (!response.ok) throw new Error('Could not load analyses.');
        const data = await response.json();
        const results = [...(data.results || [])];
        if (sort?.value === 'date') {
          results.sort((a, b) => Date.parse(b.policy_revision?.source_date || '') - Date.parse(a.policy_revision?.source_date || ''));
        } else if (sort?.value === 'name') {
          results.sort((a, b) => String(a.hostname).localeCompare(String(b.hostname)));
        } else {
          results.sort((a, b) => (b.aggregate?.score ?? -1) - (a.aggregate?.score ?? -1));
        }
        renderAnalyses(target, results);
      } catch (error) {
        target.textContent = error instanceof Error ? error.message : 'Could not load analyses.';
      }
    }
  </script>
</Base>
