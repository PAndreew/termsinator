---
import Base from '../layouts/Base.astro';
---
<Base title="Analysed policies">
  <h1>Analysed policies</h1>

  <form id="filters">
    <select id="offering" aria-label="Offering type"><option value="">All offering types</option></select>
    <select id="sector" aria-label="Sector"><option value="">All sectors</option></select>
    <select id="sort" aria-label="Sort order">
      <option value="score">Highest score</option>
      <option value="date">Newest analysis</option>
      <option value="name">Name</option>
    </select>
  </form>

  <div id="analyses" aria-live="polite">Loading…</div>

  <script>
    interface Analysis {
      hostname: string;
      classification?: { offering_type?: string; sector?: string; subcategory?: string };
      aggregate?: { score?: number; verdict?: string; model_count?: number };
      policy_revision?: { source_date?: string };
    }

    const target = document.querySelector('#analyses');
    const offering = document.querySelector('#offering');
    const sector = document.querySelector('#sector');
    const sort = document.querySelector('#sort');

    fetch('/api/v1/categories').then(response => response.json()).then(data => {
      if (offering instanceof HTMLSelectElement) {
        offering.insertAdjacentHTML('beforeend', data.offering_types.map((item: {id: string; label: string}) => `<option value="${item.id}">${escapeHTML(item.label)}</option>`).join(''));
      }
      if (sector instanceof HTMLSelectElement) {
        sector.insertAdjacentHTML('beforeend', data.sectors.map((item: {id: string; label: string}) => `<option value="${item.id}">${escapeHTML(item.label)}</option>`).join(''));
      }
    });

    for (const control of [offering, sector, sort]) control?.addEventListener('change', load);
    load();

    async function load() {
      if (!(target instanceof HTMLElement)) return;
      target.textContent = 'Loading…';
      const params = new URLSearchParams();
      if (offering instanceof HTMLSelectElement && offering.value) params.set('offering_type', offering.value);
      if (sector instanceof HTMLSelectElement && sector.value) params.set('sector', sector.value);
      const endpoint = params.size ? `/api/v1/rankings?${params}` : '/api/v1/analyses';
      try {
        const response = await fetch(endpoint);
        if (!response.ok) throw new Error('Could not load analyses');
        const data = await response.json();
        const results = [...data.results] as Analysis[];
        if (sort instanceof HTMLSelectElement && sort.value === 'date') {
          results.sort((a, b) => Date.parse(b.policy_revision?.source_date || '') - Date.parse(a.policy_revision?.source_date || ''));
        } else if (sort instanceof HTMLSelectElement && sort.value === 'name') {
          results.sort((a, b) => a.hostname.localeCompare(b.hostname));
        } else {
          results.sort((a, b) => (b.aggregate?.score ?? -1) - (a.aggregate?.score ?? -1));
        }
        render(results);
      } catch (error) {
        target.textContent = error instanceof Error ? error.message : 'Could not load analyses';
      }
    }

    function render(results: Analysis[]) {
      if (!(target instanceof HTMLElement)) return;
      if (!results.length) {
        target.innerHTML = '<p>No completed analyses yet.</p>';
        return;
      }
      target.innerHTML = results.map(item => {
        const classification = item.classification || {};
        const aggregate = item.aggregate || {};
        const sourceDate = item.policy_revision?.source_date ? new Date(item.policy_revision.source_date).toLocaleDateString() : 'Unknown date';
        return `<article class="analysis">
          <h2>${escapeHTML(item.hostname)}</h2>
          <div class="meta">
            <span class="score">${aggregate.score ?? '—'}/100</span>
            <span>${escapeHTML(String(aggregate.verdict || 'insufficient evidence').replaceAll('_', ' '))}</span>
            <span>${aggregate.model_count || 0} model(s)</span>
            <span>${escapeHTML(classification.offering_type || 'unclassified')}</span>
            <span>${escapeHTML(classification.subcategory || '')}</span>
            <span>${escapeHTML(sourceDate)}</span>
          </div>
        </article>`;
      }).join('');
    }

    function escapeHTML(value: unknown) {
      const span = document.createElement('span');
      span.textContent = String(value);
      return span.innerHTML;
    }
  </script>
</Base>
