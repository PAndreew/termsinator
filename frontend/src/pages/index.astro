---
import Base from '../layouts/Base.astro';
---
<Base title="Termsinator">
  <h1>Know what you agree to</h1>
  <p class="tagline">LLM powered policy analysis</p>
  <form id="analyse" class="submit-form">
    <label style="position:absolute;left:-9999px" for="url">Website URL</label>
    <input id="url" name="url" type="url" required placeholder="https://example.com" autocomplete="url" />
    <button type="submit">Submit</button>
  </form>
  <div id="status" class="status" role="status" aria-live="polite"></div>

  <section class="analysed-policies" aria-labelledby="analysed-heading">
    <h2 id="analysed-heading">Analysed policies</h2>
    <p class="muted">Open a snapshot to read its complete criterion-by-criterion analysis and citations.</p>
    <form class="ranking-filters" id="homepage-filters">
      <label for="homepage-grade">Filter ranking</label>
      <select id="homepage-grade">
        <option value="">All grades</option>
        <option value="A">Grade A</option><option value="B">Grade B</option>
        <option value="C">Grade C</option><option value="D">Grade D</option><option value="E">Grade E</option>
      </select>
    </form>
    <div id="homepage-analyses" aria-live="polite">Loading…</div>
  </section>

  <script>
    const form = document.querySelector('#analyse');
    const status = document.querySelector('#status');
    let timer: number | undefined;
    const requestedURL = new URLSearchParams(window.location.search).get('url');
    const initialInput = document.querySelector('#url');
    if (requestedURL && initialInput instanceof HTMLInputElement) initialInput.value = requestedURL;

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const input = document.querySelector('#url');
      const button = form.querySelector('button');
      if (!(input instanceof HTMLInputElement) || !(status instanceof HTMLElement)) return;
      if (button instanceof HTMLButtonElement) button.disabled = true;
      status.textContent = 'Submitting URL…';
      try {
        const response = await fetch('/api/v1/analysis-requests', {
          method: 'POST',
          headers: {'content-type': 'application/json'},
          body: JSON.stringify({url: input.value})
        });
        const request = await response.json();
        if (!response.ok) throw new Error(request.error || 'Submission failed');
        await poll(request.id);
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'Submission failed';
        if (button instanceof HTMLButtonElement) button.disabled = false;
      }
    });

    async function poll(id: string) {
      if (!(status instanceof HTMLElement)) return;
      const response = await fetch(`/api/v1/analysis-requests/${encodeURIComponent(id)}`);
      const request = await response.json();
      if (!response.ok) throw new Error(request.error || 'Could not load analysis');
      status.textContent = `${request.normalized_url} — ${request.status}`;
      if (request.status === 'complete') {
        status.innerHTML = `Analysis complete. <a href="/analyses/">View analysed policies</a>`;
        return;
      }
      if (request.status === 'failed') return;
      clearTimeout(timer);
      timer = setTimeout(() => poll(id).catch(error => { status.textContent = error.message; }), 3000);
    }
  </script>

  <script is:inline type="module">
    import { renderAnalyses } from '/analysis-snapshots.js';
    const target = document.querySelector('#homepage-analyses');
    const grade = document.querySelector('#homepage-grade');
    grade?.addEventListener('change', loadAnalyses);
    loadAnalyses();

    async function loadAnalyses() {
      if (!target) return;
      target.textContent = 'Loading…';
      const endpoint = grade?.value ? `/api/v1/rankings?grade=${encodeURIComponent(grade.value)}` : '/api/v1/analyses';
      try {
        const response = await fetch(endpoint);
        if (!response.ok) throw new Error('Could not load analysed policies.');
        const data = await response.json();
        renderAnalyses(target, data.results || []);
      } catch (error) {
        target.textContent = error.message || 'Could not load analysed policies.';
      }
    }
  </script>
</Base>
