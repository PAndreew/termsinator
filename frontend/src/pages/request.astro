---
import Base from '../layouts/Base.astro';
---
<Base title="Analysis status">
  <h1>Analysis status</h1>
  <div id="status" class="status" role="status" aria-live="polite">Loading…</div>
  <p><a href="/">Submit another site</a></p>
  <script>
    const id = new URLSearchParams(location.search).get('id');
    const element = document.querySelector('#status');
    async function refresh() {
      if (!id || !(element instanceof HTMLElement)) return;
      try {
        const response = await fetch(`/api/v1/analysis-requests/${encodeURIComponent(id)}`);
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Request not found');
        element.innerHTML = `<strong>${result.status}</strong><br><span class="quiet">${result.normalized_url}</span>`;
        if (result.status === 'queued' || result.status === 'running') setTimeout(refresh, 3000);
      } catch (error) {
        element.textContent = error instanceof Error ? error.message : 'Could not load status';
      }
    }
    refresh();
  </script>
</Base>
